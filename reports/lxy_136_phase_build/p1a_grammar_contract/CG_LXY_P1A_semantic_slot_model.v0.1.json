      "slot_id": "UNRESOLVED",
      "slot_name": "unresolved",
      "allowed_lexical_types": [
        "UNKNOWN_COMPONENT",
        "NUMERIC_COMPONENT",
        "LEFT_HAND_ACTION_COMPONENT",
        "RIGHT_HAND_ACTION_COMPONENT",
        "STATE_MARKER_COMPONENT",
